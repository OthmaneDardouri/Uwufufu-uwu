# Copy to .env and fill in. Never commit .env.

# Port on your computer where the site appears: http://localhost:8787
# Change it if another program already uses it.
HOST_PORT=8787

# Secret that unlocks the admin panel (at least 16 characters).
# Generate one with:  openssl rand -hex 24
ADMIN_TOKEN=

# Claude API key, used only by the server for category generation and style transfer.
# Leave empty to disable the AI features (everything else keeps working).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Optional: other sites allowed to call this API (e.g. a GitHub Pages copy of the frontend).
ALLOWED_ORIGINS=

# Optional: Cloudflare Tunnel token, to make the server reachable from the internet.
TUNNEL_TOKEN=
